{
  "version": 1,
  "vllm": {
    "upstream_url": "http://127.0.0.1:30000",
    "api_key_env": "VLLM_API_KEY",
    "request_timeout_seconds": 600,
    "audit_log": "./output/custom_hybrid/vllm_requests.jsonl",
    "audit_prompt_preview_chars": 0,
    "server_args": {
      "port": 30000,
      "gpu_memory_utilization": 0.85,
      "max_model_len": 32768,
      "max_num_seqs": 8,
      "generation_config": "vllm"
    },
    "proxy": {
      "host": "127.0.0.1",
      "port": 30001,
      "allow_public_bind": false
    },
    "generation": {
      "defaults": {},
      "overrides": {
        "max_tokens": 2048,
        "temperature": 0.0,
        "top_p": 1.0,
        "seed": 42
      },
      "context_reserve_tokens": 4096,
      "remove": [
        "top_k",
        "presence_penalty",
        "frequency_penalty",
        "vllm_xargs"
      ],
      "rules": [
        {
          "name": "deterministic-ocr",
          "match": {
            "text_regex": "ocr|recogniz|transcri|extract"
          },
          "overrides": {
            "temperature": 0.0,
            "top_p": 1.0
          }
        }
      ]
    }
  },
  "mineru": {
    "backend": "hybrid-http-client",
    "effort": "medium",
    "method": "auto",
    "lang": "ch",
    "formula": false,
    "table": true,
    "image_analysis": false,
    "extra_args": []
  },
  "fusion": {
    "enabled": true,
    "mode": "hybrid_fusion",
    "min_overlap": 0.5,
    "min_ocr_confidence": 0.82,
    "consensus_similarity": 0.94,
    "candidate_guard_similarity": 0.55,
    "suspicious_length_ratio": 1.8,
    "max_verifications_per_document": 0,
    "table_fallback_enabled": true,
    "formula_fallback_enabled": false,
    "table_visual_verification_enabled": false,
    "formula_visual_verification_enabled": false,
    "table_consensus_similarity": 0.98,
    "formula_consensus_similarity": 0.98,
    "max_structured_verifications_per_document": 0,
    "table_cell_fusion_enabled": true,
    "table_cell_empty_fallback_enabled": true,
    "table_cell_suspicious_fallback_enabled": true,
    "table_cell_allow_unscored_ocr": false,
    "table_cell_consensus_similarity": 0.98,
    "table_cell_min_ocr_confidence": 0.85,
    "table_cell_metadata_text_similarity": 0.8,
    "max_table_cells_per_table": 500,
    "max_table_cell_verifications_per_document": 0,
    "recover_missing_ocr_blocks": true,
    "missing_ocr_min_confidence": 0.9,
    "max_missing_ocr_blocks_per_document": 200,
    "unreliable_table_recovery_enabled": true,
    "unreliable_table_allow_unscored_ocr": true,
    "max_unreliable_table_ocr_blocks_per_document": 1000,
    "form_detection": {
      "enabled": true,
      "render_scale": 2.0,
      "existing_table_coverage_threshold": 0.75
    },
    "recognizer": {
      "enabled": false,
      "base_url": null,
      "model": null,
      "api_key_env": "VLLM_API_KEY",
      "normal_ocr_enabled": true,
      "table_ocr_enabled": true,
      "prefer_vlm_for_unscored": true,
      "min_similarity": 0.35,
      "min_length_ratio": 0.4,
      "max_length_ratio": 2.5,
      "high_confidence_threshold": 0.95,
      "assumed_vlm_confidence": 0.9,
      "max_candidates_per_document": 1000,
      "max_text_chars": 512,
      "batch_guard_enabled": true,
      "min_batch_acceptable_ratio": 0.5,
      "batch_guard_min_candidates": 3,
      "empty_ocr_enabled": true,
      "selection_policy": "conservative",
      "vlm_primary_min_quality": 0.5,
      "recovered_empty_min_confidence": 0.9,
      "temperature": 0.0,
      "top_p": 1.0,
      "seed": 42,
      "json_mode": true,
      "protocol": "auto",
      "structured_output_mode": "json_schema",
      "structured_max_tokens_cap": 1024,
      "max_consecutive_invalid_schema": 2,
      "native_prompt": "\nText Recognition:",
      "native_system_prompt": "You are a helpful assistant.",
      "native_min_bbox_height": 16.0,
      "native_all_candidates": false,
      "native_max_tokens": 512,
      "native_max_candidates_per_page": 0,
      "native_max_requests_per_page": 0,
      "native_max_concurrency": 2,
      "native_max_consecutive_failures": 3,
      "native_cache_enabled": true,
      "native_cache_dir": "~/.cache/mineru/custom-hybrid/native-recognition",
      "native_cache_ttl_seconds": 2592000,
      "disable_structured_output_whitespace": true,
      "hide_ids_in_prompt_when_constrained": true,
      "max_tokens": 1024,
      "max_context_tokens": null,
      "context_reserve_tokens": 2048,
      "timeout_seconds": 120,
      "target_render_scale": 4.0,
      "context_render_scale": 2.0,
      "target_padding_ratio": 0.12,
      "context_padding_ratio": 0.03,
      "jpeg_quality": 92,
      "cache_pages": 2,
      "max_batch_size": 8,
      "max_images_per_request": 8,
      "max_image_limit_retries": 2,
      "max_requests_per_document": 80,
      "max_prompt_chars": 16000,
      "candidate_text_max_chars": 512,
      "audit_response_preview_chars": 0,
      "include_row_image": true,
      "include_column_image": false,
      "include_table_image": false
    },
    "recovery": {
      "enabled": false,
      "base_url": null,
      "model": null,
      "api_key_env": "VLLM_API_KEY",
      "temperature": 0.0,
      "top_p": 1.0,
      "seed": 42,
      "max_tokens": 1024,
      "structured_max_tokens_cap": 768,
      "timeout_seconds": 120,
      "render_scale": 2.0,
      "cache_pages": 2,
      "jpeg_quality": 92,
      "min_ink_ratio": 0.002,
      "min_uncovered_ink_ratio": 0.15,
      "local_missing_enabled": true,
      "local_pixel_confidence": 0.95,
      "review_after_local_recovery": false,
      "skip_vlm_for_mineru_models": true,
      "share_recognizer_page_cache": true,
      "table_orphan_recovery_enabled": true,
      "table_orphan_max_boxes_per_table": 12,
      "table_orphan_confidence": 0.92,
      "table_orphan_max_cell_overlap": 0.25,
      "table_orphan_cell_padding": 1.5,
      "table_orphan_horizontal_line_ratio": 0.5,
      "table_orphan_vertical_line_ratio": 0.5,
      "table_orphan_min_row_ink_pixels": 4,
      "table_orphan_line_gap": 0.75,
      "table_orphan_min_line_height": 4.0,
      "table_orphan_min_dark_height": 2.0,
      "table_orphan_min_line_width": 20.0,
      "table_orphan_min_ink_density": 0.01,
      "table_orphan_max_ink_density": 0.7,
      "table_orphan_max_line_height_ratio": 0.07,
      "checkbox_recovery_enabled": true,
      "checkbox_max_boxes_per_table": 40,
      "checkbox_confidence": 0.95,
      "checkbox_ambiguous_confidence": 0.9,
      "checkbox_min_size": 5.0,
      "checkbox_max_size": 16.0,
      "checkbox_min_aspect": 0.75,
      "checkbox_max_aspect": 1.25,
      "checkbox_min_side_density": 0.35,
      "checkbox_max_vertices": 5,
      "checkbox_ambiguous_max_vertices": 4,
      "checkbox_left_clearance": 8.0,
      "checkbox_max_left_ink_ratio": 0.08,
      "checkbox_table_edge_allowance": 12.0,
      "checkbox_right_context": 30.0,
      "checkbox_min_right_ink_ratio": 0.01,
      "checkbox_right_separator_search": 6.0,
      "checkbox_min_right_separator": 1.5,
      "checkbox_right_column_ink_ratio": 0.05,
      "checkbox_unchecked_interior_ratio": 0.03,
      "checkbox_checked_interior_ratio": 0.12,
      "checkbox_existing_tight_scale": 2.0,
      "checkbox_apply_min_size": 4.0,
      "checkbox_apply_max_size": 20.0,
      "checkbox_apply_min_aspect": 0.65,
      "checkbox_apply_max_aspect": 1.4,
      "disable_after_invalid_schema": true,
      "min_confidence": 0.85,
      "min_area_ratio": 0.001,
      "max_area_ratio": 0.95,
      "duplicate_iou": 0.6,
      "adjust_min_iou": 0.05,
      "max_tables_per_document": 10,
      "max_proposals_per_document": 100,
      "max_proposals_per_table": 30,
      "max_requests_per_document": 10
    },
    "reconciliation": {
      "enabled": false,
      "max_pages_per_document": 20,
      "max_candidates_per_page": 120
    },
    "verifier": {
      "enabled": false,
      "base_url": null,
      "model": null,
      "api_key_env": "VLLM_API_KEY",
      "temperature": 0.0,
      "top_p": 1.0,
      "seed": 42,
      "json_mode": true,
      "max_tokens": 1024,
      "timeout_seconds": 120,
      "render_scale": 2.0,
      "table_cell_render_scale": 4.0,
      "padding_ratio": 0.08,
      "jpeg_quality": 92,
      "cache_pages": 2,
      "structured_candidate_max_chars": 12000,
      "page_reconciliation_max_chars": 12000,
      "table_cell_context_max_chars": 4000,
      "table_cell_max_context_cells": 40,
      "table_cell_include_table_image": true,
      "table_cell_include_row_image": true,
      "table_cell_include_column_image": true
    }
  },
  "sweep": {
    "generation": {
      "temperature": [0.0, 0.1],
      "top_p": [0.95, 1.0],
      "repetition_penalty": [1.0, 1.03]
    },
    "max_runs": 8
  },
  "evaluation": {
    "regression_tolerance": 0.002,
    "normalization": {
      "unicode_nfkc": true,
      "trim_trailing_whitespace": true,
      "collapse_blank_lines": true,
      "collapse_whitespace": false
    }
  }
}
